# Neon: pooled URL for the running app, direct URL only for schema migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk Authentication: username/password, optional email, and Google sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Application and providers.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SMSPOOL_API_KEY=""
SMSPOOL_BASE_URL="https://api.smspool.net"
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""
TEXTVERIFIED_EMAIL=""
TEXTVERIFIED_API_KEY=""
# Comma-separated Clerk user IDs. Do not grant admin access by mutable usernames.
ADMIN_USER_IDS=""
CONTACT_EMAIL_USER=""
CONTACT_EMAIL_PASS=""
CONTACT_EMAIL_TO=""
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""
