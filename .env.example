# Neon: pooled URL for the running app, direct URL only for schema migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth: server-side session signing and database-backed authentication.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Application and providers.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
SMSPOOL_API_KEY=""
SMSPOOL_BASE_URL="https://api.smspool.net"
PROXYAPP_BASE_URL="https://www.proxyapp.net/api"
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""
TEXTVERIFIED_EMAIL=""
TEXTVERIFIED_API_KEY=""
# Comma-separated Better Auth user IDs. Do not grant admin access by mutable usernames.
ADMIN_USER_IDS=""
CONTACT_EMAIL_USER=""
CONTACT_EMAIL_PASS=""
CONTACT_EMAIL_TO=""
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""
