{
  "name": "verifio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/migrate-neon.ts",
    "db:check": "node --env-file=.env.local --experimental-strip-types scripts/check-neon.ts",
    "db:proxy:check": "node --env-file=.env.local --experimental-strip-types scripts/check-proxy-data.ts",
    "auth:check": "node --env-file=.env.local --experimental-strip-types scripts/check-auth.ts",
    "auth:test": "node --env-file=.env.local --experimental-strip-types scripts/test-auth-flow.ts",
    "smspool:check": "node --env-file=.env.local --experimental-strip-types scripts/check-smspool.ts",
    "proxy:blocklist:check": "node --experimental-strip-types scripts/check-proxy-blocklist.ts",
    "proxy:pricing:check": "node --experimental-strip-types scripts/check-proxy-pricing.ts",
    "textverified:rentals:check": "node --experimental-strip-types scripts/check-textverified-rentals.ts",
